{
  "name": "deepread",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "phone": "node scripts/phone.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "storage:migrate": "node scripts/storage-migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@napi-rs/canvas": "1.0.9",
    "@vitejs/plugin-react": "^6.1.1",
    "hono": "^4.13.12",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "momentic": "3.62.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
