# DeepRead settings.
# Copy this file to .env.local and fill it in: cp .env.example .env.local
# .env.local is never committed. Values already set in the shell win over this file.

# Where your books and notes are kept.
#   local - the data folder on this computer (the default)
#   r2    - a Cloudflare R2 bucket, so the library survives this computer
DEEPREAD_STORAGE=local

# The most space your library may take up. An upload that would go past it is refused.
# Units: KB, MB, GB, TB (1 GB = 1000 MB) or KiB, MiB, GiB, TiB (1 GiB = 1024 MiB).
# Leave it empty for no limit.
DEEPREAD_STORAGE_LIMIT=8GB

# Cloudflare R2, used only when DEEPREAD_STORAGE=r2.
# In the Cloudflare dashboard: R2 > Manage API tokens > Create API token, with "Object Read & Write" on your bucket.
# The page that follows shows the access key id, the secret access key and the S3 endpoint.
# Use the jurisdiction endpoint when the bucket has one, e.g. https://<account_id>.eu.r2.cloudflarestorage.com
DEEPREAD_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
DEEPREAD_R2_BUCKET=<bucket-name>
DEEPREAD_R2_ACCESS_KEY_ID=<access-key-id>
DEEPREAD_R2_SECRET_ACCESS_KEY=<secret-access-key>
# The folder inside the bucket that DeepRead uses, so the bucket can hold other things too.
DEEPREAD_R2_PREFIX=deepread/
